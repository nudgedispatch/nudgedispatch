# Copy to .dev.vars for local wrangler. Do not commit .dev.vars or put a real address here.
# Comma-separated. Unset or empty means nobody is a platform admin.
PLATFORM_ADMIN_EMAILS=
SMS_MODE=off
# Stripe. Leave unset for a test key. Live mode also needs STRIPE_MODE=live. Do not commit keys.
# STRIPE_MODE=test
# Optional. Off unless set. Do not commit keys.
# PLACES_AUTOCOMPLETE=off
# FLIGHT_DATA_PROVIDER=off
# Distance pricing. Server-only Routes key (Worker secret in production). Do not commit keys.
# GOOGLE_ROUTES_KEY=YOUR_KEY_HERE
# Local only, on localhost: fake road distances without a key.
# QUOTE_DEV_FAKE_ROUTE=1
# ROUTES_DAILY_CAP=500
# Browser key for Places Autocomplete on the booking page (referrer-restricted).
# GOOGLE_MAPS_BROWSER_KEY=YOUR_KEY_HERE
# Flight lookup: aeroapi | aerodatabox | cirium | off. Only aeroapi is built.
# FLIGHT_PROVIDER=off
# FLIGHT_API_KEY=YOUR_KEY_HERE
# FLIGHT_DAILY_CAP=200
# Per-fleet Routes caps (Eastern day). Defaults shown.
# ROUTES_FLEET_DAILY_CAP=500
# ROUTES_PUBLIC_DAILY_CAP=150
# ROUTES_FLEET_RESERVE=50
# FLIGHT_FLEET_DAILY_CAP=100
# Owner/driver app suggestions use the signed-in /api/places/* proxy with this server key (never the browser key).
# GOOGLE_MAPS_SERVER_KEY=YOUR_KEY_HERE
