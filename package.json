{
  "name": "nudge-dispatch",
  "private": true,
  "type": "module",
  "description": "Nudge Dispatch operator app. Canonical repository: github.com/nudgedispatch/nudgedispatch",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "e2e:booking": "bash scripts/predeploy-e2e.sh",
    "deploy:prod": "bash scripts/deploy-prod.sh"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "playwright-core": "^1.59.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  },
  "engines": {
    "node": ">=22"
  }
}
